		"build:release": "../../scripts/build-release.sh"
	},
	"dependencies": {
		"@opentui/core": "^0.5.9",
		"@opentui/react": "^0.5.9",
		"@stm/game": "workspace:*",
		"convex": "^1.43.0",
		"react": "^19.2.8"
	},
	"optionalDependencies": {
		"@opentui/core-darwin-arm64": "0.5.9",
		"@opentui/core-darwin-x64": "0.5.9"
	}
}
